# Entorno y servidor
NODE_ENV=development
PORT=3001

# Configuración SMTP (servidor de correo)
EMAIL_HOST=mail.tudominio.cl
EMAIL_PORT=587
EMAIL_USER=tu@email.com
EMAIL_PASS=tu_password

# Token para autenticación de la API (usado por el frontend)
API_TOKEN=generate-a-secure-random-token

# Rate limit (milisegundos, max solicitudes por ventana)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3

# Habilitar/deshabilitar CORS (true/false)
CORS_ENABLED=true

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,https://tu-dominio.cl
